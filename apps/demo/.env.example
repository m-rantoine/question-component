# Copy to .env and fill in. This file is committed; .env is not.

# Supabase — project settings → API.
PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never give this one a PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Teacher sign-in. All three or none: with any of them missing the dashboard
# runs unprotected and says so. Generate the secret with `openssl rand -base64 32`.
ASKQ_TEACHER_USER=
ASKQ_TEACHER_PASSWORD=
ASKQ_AUTH_SECRET=
