---
import Base from '../layouts/Base.astro';
import SiteText from '../components/SiteText.tsx';
---

<Base titleKey="home.title">
  <SiteText client:load k="home.title" as="h1" />
  <SiteText client:load k="home.lede" as="p" className="lede" />

  <ul class="card-list">
    <li>
      <a href="/lessons/lesson-one">
        <SiteText client:load k="home.lesson" as="strong" />
        <SiteText client:load k="home.lessonNote" as="span" />
      </a>
    </li>
    <li>
      <a href="/lessons/reading-one">
        <SiteText client:load k="home.reading" as="strong" />
        <SiteText client:load k="home.readingNote" as="span" />
      </a>
    </li>
  </ul>

  <SiteText client:load k="home.dashboard" as="h2" />
  <SiteText client:load k="home.dashboardNote" as="p" className="lede" />
</Base>
