---
import type { GetStaticPaths } from 'astro';
import { questionsInGroup, registeredGroupIds } from '@askq/react';
import Base from '../../../../layouts/Base.astro';
import Dashboard from '../../../../components/Dashboard.tsx';
import '../../../../questions';

export const getStaticPaths = (() =>
  registeredGroupIds().flatMap((groupId) =>
    questionsInGroup(groupId).map((question) => ({
      params: { groupId, questionId: question.questionId },
    })),
  )) satisfies GetStaticPaths;

const { groupId, questionId } = Astro.params;
---

<Base
  titleKey="dashboard.docTitle"
  titleSuffix={`${groupId} / ${questionId}`}
  noindex
  hideIdentity
>
  <Dashboard client:load show="question" groupId={groupId!} questionId={questionId!} />
</Base>
