---
import Base from '../../layouts/Base.astro';
import TeacherSignIn from '../../components/TeacherSignIn.tsx';
import UnprotectedNotice from '../../components/UnprotectedNotice.tsx';
import { isTeacherAuthConfigured } from '../../lib/teacher-auth';

export const prerender = false;

const configured = isTeacherAuthConfigured();
---

<Base titleKey="dashboard.docTitle" noindex hideIdentity>
  {
    configured ? (
      <TeacherSignIn client:load />
    ) : (
      <UnprotectedNotice client:load k="dashboard.signInMissing" />
    )
  }
</Base>
