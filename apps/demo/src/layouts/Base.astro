---
import Nav from '../components/Nav.tsx';
import SetupNotice from '../components/SetupNotice.tsx';
import SiteText from '../components/SiteText.tsx';
import DocumentTitle from '../components/DocumentTitle.tsx';
import type { SiteKey } from '../lib/site-text';
import '@askq/react/styles.css';
import '../styles/site.css';

interface Props {
  /** Key for the document title; kept in step with the language picker. */
  titleKey: SiteKey;
  /** Appended to the title after an em dash. Ids, so not translated. */
  titleSuffix?: string;
  noindex?: boolean;
  /** Hides the student badge, which means nothing on the teacher dashboard. */
  hideIdentity?: boolean;
}

const { titleKey, titleSuffix, noindex = false, hideIdentity = false } = Astro.props;
---

<!doctype html>
<!-- Server-rendered in the default locale; the i18n store corrects it on hydration. -->
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Pose une question</title>
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <DocumentTitle client:load k={titleKey} suffix={titleSuffix} />
  </head>
  <body>
    <header class="site-header">
      <a class="site-header__brand" href="/">
        <SiteText client:load k="site.brand" />
      </a>
      <Nav client:load showIdentity={!hideIdentity} />
    </header>

    <main class="site-main">
      <SetupNotice client:load />
      <slot />
    </main>

    <footer class="site-footer">
      <SiteText client:load k="site.footer" as="p" />
    </footer>
  </body>
</html>
