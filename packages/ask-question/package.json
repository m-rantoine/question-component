{
  "name": "@askq/react",
  "version": "0.1.0",
  "description": "React components for asking students questions and showing a teacher what the class answered.",
  "type": "module",
  "license": "MIT",
  "sideEffects": true,
  "files": [
    "dist",
    "bin",
    "supabase",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./dashboard": {
      "types": "./dist/dashboard.d.ts",
      "import": "./dist/dashboard.js",
      "require": "./dist/dashboard.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsup && node scripts/check-build.mjs",
    "dev": "tsup --watch",
    "prepare": "node scripts/prepare.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "supabase": "^2.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m-rantoine/question-component.git",
    "directory": "packages/ask-question"
  },
  "keywords": [
    "react",
    "astro",
    "nextjs",
    "education",
    "quiz",
    "formative-assessment",
    "supabase"
  ],
  "bin": {
    "askq-setup": "./bin/askq-setup.mjs"
  }
}
