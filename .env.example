# Client-side (must be PUBLIC_ prefixed so Astro exposes them to the browser).
# The anon key is insert-only by RLS; see supabase/schema.sql.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER prefix this with PUBLIC_ and never import it in a component.
# Used exclusively by src/pages/api/answers.ts to read results for the dashboard.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
